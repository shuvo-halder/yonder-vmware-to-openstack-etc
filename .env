# --- Version pin (optional; defaults to :latest) ---
YONDER_VERSION=0.11.0

# --- Django core ---
DJANGO_SETTINGS_MODULE=yonder_platform.settings.production
SECRET_KEY=CHANGE_ME_LONG_RANDOM_50_CHARS
DEBUG=False
ALLOWED_HOSTS=<HOST_IP_OR_DOMAIN>
SITE_URL=http://<HOST_IP_OR_DOMAIN>:8077

# --- Database (PostgreSQL local to the compose) ---
DB_HOST=localhost
DB_PORT=5434
DB_NAME=yonder
DB_USER=yonder
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Redis (Celery broker) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_DEFAULT_QUEUE=default
CELERY_CONCURRENCY=4
CELERY_CONVERSION_CONCURRENCY=1

# --- Gunicorn ---
GUNICORN_PORT=8011
GUNICORN_WORKERS=4

# --- Nginx ---
NGINX_HTTP_PORT=8077

# --- JWT ---
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# --- Superuser bootstrap (first boot only; leave blank to disable) ---
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- Fernet key (credential encryption) ---
# Auto-generated by the entrypoint if empty and persisted in the volume,
# but pinning it explicitly is recommended.
YONDER_FERNET_KEY=CHANGE_ME_FERNET_KEY

# --- Identity ---
YONDER_INSTANCE_NAME=Yonder
YONDER_LANGUAGE=fr-fr
YONDER_TIMEZONE=UTC

# --- System introspection ---
SYSTEM_EXCLUDED_INTERFACES=lo,docker,br-,veth
SYSTEM_MOUNT_TYPES_INCLUDED=nfs,nfs4,cifs,ceph,fuse.glusterfs,ext4,xfs,btrfs,zfs

# --- Optional guest fixup features (opt-in, default OFF) ---
MIGRATION_V2V_FIXUP=true
MIGRATION_L3_FIXUP=true
